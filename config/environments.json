{
  "schemaVersion": 1,
  "defaultEnvironment": "prod",
  "profiles": {
    "dev": {
      "allowedReleaseChannels": ["alpha", "beta", "rc"],
      "localFirst": true,
      "cloudServicesEnabledByDefault": false,
      "rawDocumentsCloudAllowedByDefault": false,
      "aiEnabledByDefault": false,
      "diagnostics": {
        "level": "debug",
        "includeRawLegalData": false
      },
      "signingPolicy": "development-build"
    },
    "stage": {
      "allowedReleaseChannels": ["beta", "rc"],
      "localFirst": true,
      "cloudServicesEnabledByDefault": false,
      "rawDocumentsCloudAllowedByDefault": false,
      "aiEnabledByDefault": false,
      "diagnostics": {
        "level": "operational",
        "includeRawLegalData": false
      },
      "signingPolicy": "signed-build-required"
    },
    "prod": {
      "allowedReleaseChannels": ["rc", "stable"],
      "localFirst": true,
      "cloudServicesEnabledByDefault": false,
      "rawDocumentsCloudAllowedByDefault": false,
      "aiEnabledByDefault": false,
      "diagnostics": {
        "level": "privacy-light",
        "includeRawLegalData": false
      },
      "signingPolicy": "signed-build-required"
    }
  },
  "runtimeOverridePolicy": {
    "allowed": [
      "account.enabled",
      "account.supabaseUrl",
      "account.publishableKey",
      "account.apiBaseUrl",
      "account.offlineGraceDays"
    ],
    "forbidden": [
      "service_role",
      "secretKey",
      "privateKey",
      "rawDocumentUploadByDefault"
    ]
  }
}
